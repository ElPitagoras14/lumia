# Copy to `.env` and fill in the signing keys and the owner account. Both
# profiles below declare the same variable names; only the value of DATA_DIR
# differs between them.

# --- Profile: containers (`docker compose up`) ---------------------------

# Host port where nginx serves the app: http://localhost:${HTTP_PORT}
HTTP_PORT=8080

# Directory holding lumia.db and the photo originals. In containers it is
# the mount point of the `lumia-data` volume.
DATA_DIR=/data

# imgproxy URL signing, hex-encoded. The backend signs the image URLs with the
# same pair imgproxy validates them with. Generate each one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
IMAGE_SIGNING_KEY=
IMAGE_SIGNING_SALT=

# The owner account, created on the first start only, while there are no users.
# Changing them afterwards does not change the account (use `reset-password`,
# see the README), but the backend refuses to start without them. The password
# takes 8 characters to 72 bytes.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Profile: native (`uv run` + `pnpm dev`) ------------------------------
# Same names, one different value. Export these in the shell that runs the
# backend from `backend/`:
#
#   HTTP_PORT=8080            (unused natively, kept so both profiles match)
#   DATA_DIR=./data           (resolves to backend/data/, ignored by git)
#   IMAGE_SIGNING_KEY=<same>
#   IMAGE_SIGNING_SALT=<same>
#   ADMIN_EMAIL=<same>
#   ADMIN_PASSWORD=<same>
