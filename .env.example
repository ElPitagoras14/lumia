# Copy to `.env` and fill in the signing keys. Both profiles below declare the
# same variable names; only the value of DATA_DIR differs between them.

# --- Profile: containers (`docker compose up`) ---------------------------

# Host port where nginx serves the app: http://localhost:${HTTP_PORT}
HTTP_PORT=8080

# Directory holding lumia.db and the photo originals. In containers it is
# the mount point of the `lumia-data` volume.
DATA_DIR=/data

# imgproxy URL signing, hex-encoded. Generate each one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
IMAGE_SIGNING_KEY=
IMAGE_SIGNING_SALT=

# --- Profile: native (`uv run` + `pnpm dev`) ------------------------------
# Same names, one different value. Export these in the shell that runs the
# backend from `backend/`:
#
#   HTTP_PORT=8080            (unused natively, kept so both profiles match)
#   DATA_DIR=./data           (resolves to backend/data/, ignored by git)
#   IMAGE_SIGNING_KEY=<same>
#   IMAGE_SIGNING_SALT=<same>
